{
  "manifest_version": 3,
  "name": "Obsidian Social Publisher · 辅助填写",
  "version": "0.1.4",
  "description": "将已确认的本地素材填写到用户打开的小红书官方编辑器，保留人工核实。",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://creator.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Social Publisher 账号与填写工作台",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
